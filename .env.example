# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rentritz

# Flask - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin account (created on first startup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to true only in local development - never in production
DEBUG=false

# SendGrid (email)
SENDGRID_API_KEY=

# nGenius Payments
NGENIUS_OUTLET_ID=
NGENIUS_API_KEY=
NGENIUS_ENV=TEST

# Sentry error monitoring (optional — leave blank to disable)
# Get your DSN at https://sentry.io
SENTRY_DSN=

# hCaptcha bot protection (optional — leave blank to disable in local dev)
# Get free keys at https://hcaptcha.com
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
